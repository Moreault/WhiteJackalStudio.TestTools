<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>2.0.0</Version>
		<Authors>Mathieu Moreault</Authors>
		<RepositoryUrl>https://github.com/Moreault/WhiteJackalStudio.TestTools</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Moreault/WhiteJackalStudio.TestTools</PackageProjectUrl>
		<Description>Tools for unit testing White Jackal Studio projects</Description>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>testtools.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\testtools.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.3.2" />
		<PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
		<PackageReference Include="ToolBX.Eloquentest.Dummies" Version="4.0.0" />
	</ItemGroup>


</Project>